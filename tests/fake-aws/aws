#!/usr/bin/env python3
"""Fake `aws` CLI for the tests and `make demo`.

Answers the read-only calls account-baseline.sh makes from a scenario file,
accepts every write, and appends each call to $FAKE_AWS_LOG as a JSON line.
No request ever leaves the machine.
"""

import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
GLOBAL_OPTS = {"--profile", "--region", "--query", "--output"}


def parse(argv):
    opts, rest, i = {}, [], 0
    while i < len(argv):
        if argv[i] in GLOBAL_OPTS:
            opts[argv[i][2:]] = argv[i + 1]
            i += 2
        else:
            rest.append(argv[i])
            i += 1
    return opts, rest


def answer(scenario, opts, rest):
    service, op = rest[0], rest[1]
    region = scenario["regions"].get(opts.get("region", ""), {})
    if (service, op) == ("sts", "get-caller-identity"):
        return scenario["account_id"]
    if (service, op) == ("configure", "get"):
        return scenario.get("configured_region", "")
    if (service, op) == ("ec2", "describe-regions"):
        return "\t".join(scenario["regions"])
    if (service, op) == ("ec2", "describe-route-tables"):
        if "--route-table-ids" in rest:
            return "\t".join(region.get("private_subnets", []))
        return "\t".join(region.get("nat_route_tables", []))
    if (service, op) == ("ec2", "describe-vpcs"):
        return region.get("default_vpc") or "None"
    if (service, op) == ("ec2", "describe-network-interfaces"):
        return str(region.get("network_interfaces", 0))
    if (service, op) == ("ec2", "describe-internet-gateways"):
        return region.get("internet_gateway") or "None"
    if (service, op) == ("ec2", "describe-subnets"):
        return "\t".join(region.get("subnets", []))
    return ""  # a write: accept it


def main():
    opts, rest = parse(sys.argv[1:])
    path = os.environ.get("FAKE_AWS_SCENARIO", os.path.join(HERE, "scenario.json"))
    with open(path) as f:
        scenario = json.load(f)
    log = os.environ.get("FAKE_AWS_LOG")
    if log:
        with open(log, "a") as f:
            f.write(json.dumps({"opts": opts, "args": rest}) + "\n")
    out = answer(scenario, opts, rest)
    if out:
        print(out)


if __name__ == "__main__":
    main()
